---
import '../styles/site.css';
import { Image } from 'astro:assets';
import Icon from '../components/Icon.astro';
import SiteSearch from '../components/SiteSearch.astro';
import { EMAIL_HINT, EMAIL_PATTERN } from '../lib/forms';
import logo from '../assets/logo.png';
import unicornLogo from '../assets/10xunicorn.png';

interface Props {
  title: string;
  description?: string;
  /** Show the search box in the header (the recipe list has its own). */
  headerSearch?: boolean;
}

const {
  title,
  description = 'Griddle Me This, Dad? Recipes from the backyard griddle.',
  headerSearch = true,
} = Astro.props;
const fullTitle = title === 'Home' ? 'Griddle Me This, Dad?' : `${title} | Griddle Me This, Dad?`;
const nav = [
  ['/recipes/', 'Recipes'],
  ['/newsletters/', 'Newsletters'],
  ['/about/', 'About'],
  ['/contact/', 'Contact'],
];
const current = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta name="theme-color" content="#0c0a09" />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" type="image/png" href="/favicon.png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <slot name="head" />
  </head>
  <body>
    <header class="site-header">
      <div class="container">
        <a class="brand" href="/" aria-label="Griddle Me This, Dad? home">
          <Image src={logo} alt="" height={128} loading="eager" />
        </a>
        <nav class="site-nav" aria-label="Main">
          <ul>
            {
              nav.map(([href, label]) => (
                <li>
                  <a href={href} aria-current={current.startsWith(href) ? 'page' : undefined}>
                    {label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <div class="header-actions">
          {headerSearch && <SiteSearch />}
          <details class="mobile-nav">
            <summary aria-label="Menu">
              <span class="icon-menu"><Icon name="menu" size={26} /></span>
              <span class="icon-close"><Icon name="close" size={26} /></span>
            </summary>
            <ul>
              <li><a href="/">Home</a></li>
              {
                nav.map(([href, label]) => (
                  <li>
                    <a href={href}>{label}</a>
                  </li>
                ))
              }
            </ul>
          </details>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <div class="footer-grid">
          <div>
            <h2>Griddle Me This, Dad?</h2>
            <p>Recipes, tips and monthly newsletters from a dad who took his cooking out to the backyard griddle.</p>
            <ul>
              <li><a href="https://www.pinterest.com/williampickrel/">Pinterest</a></li>
              <li><a href="mailto:griddlemethisdad@gmail.com">griddlemethisdad@gmail.com</a></li>
            </ul>
          </div>
          <div>
            <h2>Explore</h2>
            <ul>
              <li><a href="/">Home</a></li>
              {
                nav.map(([href, label]) => (
                  <li>
                    <a href={href}>{label}</a>
                  </li>
                ))
              }
            </ul>
          </div>
          <div>
            <h2>Get new recipes by email</h2>
            <p>We’ll let you know when a new recipe goes up.</p>
            <form class="subscribe" name="email_subscriber" method="POST" data-netlify="true" netlify-honeypot="bot-field">
              <p hidden><label>Don’t fill this out: <input name="bot-field" /></label></p>
              <label class="visually-hidden" for="emailSub">Email address</label>
              <input
                class="input"
                id="emailSub"
                name="emailSub"
                type="email"
                required
                pattern={EMAIL_PATTERN}
                title={EMAIL_HINT}
                placeholder="you@example.com"
              />
              <button class="btn" type="submit">Subscribe</button>
            </form>
          </div>
        </div>
        <div class="footer-bottom">
          <span>© {new Date().getFullYear()} Griddle Me This, Dad?</span>
          <a class="made-by" href="https://github.com/10x-Unicorn">
            <span>Created and designed by 10xUnicorn</span>
            <Image src={unicornLogo} alt="10xUnicorn" height={96} />
          </a>
        </div>
      </div>
    </footer>

    <script>
      // Browsers count a field of only spaces as filled in, so trim before
      // checking required fields. (Netlify rewrites form tags and keeps only
      // name/method/class, so match forms by method.)
      for (const form of document.querySelectorAll<HTMLFormElement>('form[method="POST"]')) {
        const fields = form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('input[required], textarea[required]');
        const check = (field: HTMLInputElement | HTMLTextAreaElement) =>
          field.setCustomValidity(field.value.trim() === '' ? 'Please fill this in.' : '');
        fields.forEach((field) => field.addEventListener('input', () => check(field)));
        form.addEventListener('submit', (event) => {
          fields.forEach((field) => {
            field.value = field.value.trim();
            check(field);
          });
          if (!form.checkValidity()) {
            event.preventDefault();
            form.reportValidity();
          }
        });
      }
    </script>
    <slot name="scripts" />
  </body>
</html>

