---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { formatMinutes } from '../lib/recipes';

interface Props {
  recipe: CollectionEntry<'recipes'>;
  eager?: boolean;
  /** Normalized text for the recipe list's search box (see lib/recipes searchText). */
  searchText?: string;
}

const { recipe, eager = false, searchText } = Astro.props;
const { title, category, totalMinutes, hero } = recipe.data;
---

<li class="recipe-card" data-category={category} data-search={searchText}>
  <div class="recipe-card__img">
    <Image
      src={hero}
      alt=""
      width={640}
      height={480}
      widths={[320, 480, 640]}
      sizes="(min-width: 1120px) 352px, (min-width: 640px) 45vw, 100vw"
      fit="cover"
      loading={eager ? 'eager' : 'lazy'}
    />
  </div>
  <p class="eyebrow">{category}</p>
  <h3><a href={`/recipes/${recipe.id}/`}>{title}</a></h3>
  <p class="meta-inline"><Icon name="clock" size={16} /> {formatMinutes(totalMinutes)}</p>
</li>
