---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Icon from '../components/Icon.astro';

const newsletters = (await getCollection('newsletters')).sort(
  (a, b) => b.data.published.valueOf() - a.data.published.valueOf(),
);
const entries = await Promise.all(newsletters.map(async (n) => ({ ...n, Content: (await render(n)).Content })));
const formatDate = (d: Date) => d.toLocaleDateString('en-US', { dateStyle: 'long', timeZone: 'UTC' });
---

<Base title="Newsletters" description="The monthly Griddle Me This, Dad? newsletter archive.">
  <PageHead title="Newsletters" eyebrow="From the griddle">
    <p class="lede">Monthly notes on recipes, reviews, music and whatever else is on Dad’s mind.</p>
  </PageHead>

  <div class="container" style="padding-top: 32px">
    <ul class="news-list">
      {
        entries.map(({ data, Content }, i) => (
          <li class="news-item">
            <div class="news-item__img">
              <Image
                src={data.cover}
                alt=""
                width={640}
                widths={[320, 640]}
                sizes="(min-width: 700px) 320px, 100vw"
                loading={i < 2 ? 'eager' : 'lazy'}
              />
            </div>
            <div>
              <p class="eyebrow">
                <time datetime={data.published.toISOString().slice(0, 10)}>{formatDate(data.published)}</time>
              </p>
              <h2>
                <a href={data.pdf}>{data.title}</a>
              </h2>
              <Content />
              <p class="meta-inline">
                <Icon name="file" size={16} /> PDF
              </p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</Base>
