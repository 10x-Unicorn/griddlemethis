---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageBanner from '../components/PageBanner.astro';

const newsletters = (await getCollection('newsletters')).sort(
  (a, b) => b.data.published.valueOf() - a.data.published.valueOf(),
);
const entries = await Promise.all(newsletters.map(async (n) => ({ ...n, Content: (await render(n)).Content })));
const day = (d: Date) => d.toLocaleDateString('en-US', { day: 'numeric', timeZone: 'UTC' });
const month = (d: Date) => d.toLocaleDateString('en-US', { month: 'long', timeZone: 'UTC' });
const full = (d: Date) => d.toLocaleDateString('en-US', { dateStyle: 'medium', timeZone: 'UTC' });
---

<Base title="Newsletters" description="The monthly Griddle Me This, Dad? newsletter archive.">
  <PageBanner title="Newsletters" />
  <section class="blog_area section-padding">
    <div class="container">
      {
        entries.map(({ data, Content }) => (
          <article class="blog_item">
            <div class="blog_item_img newsletter-cover">
              <a href={data.pdf}>
                <Image class="card-img rounded-0" src={data.cover} alt={`${data.title} cover`} width={1200} widths={[400, 800, 1200]} sizes="(min-width: 992px) 1110px, 100vw" />
              </a>
              <span class="blog_item_date">
                <h3>{day(data.published)}</h3>
                <p>{month(data.published)}</p>
              </span>
            </div>
            <div class="blog_details">
              <a class="d-inline-block" href={data.pdf}>
                <h2>{data.title}</h2>
              </a>
              <Content />
              <ul class="blog-info-link">
                <li><i class="fa fa-calendar"></i> {full(data.published)}</li>
              </ul>
            </div>
          </article>
        ))
      }
    </div>
  </section>
</Base>
