---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import RecipeCard from '../../components/RecipeCard.astro';
import Icon from '../../components/Icon.astro';
import { getListedRecipes, searchText } from '../../lib/recipes';

const recipes = await getListedRecipes();

// Categories, most recipes first.
const counts = new Map<string, number>();
for (const r of recipes) counts.set(r.data.category, (counts.get(r.data.category) ?? 0) + 1);
const categories = [...counts].sort((a, b) => b[1] - a[1]);
---

<Base title="Recipes" description="Every Griddle Me This, Dad? recipe, newest first.">
  <PageHead title="Recipes" eyebrow="The cookbook">
    <p class="lede">Every recipe we’ve cooked on the griddle, newest first.</p>
  </PageHead>

  <div class="container">
    <!-- Filters need JavaScript, so they start hidden; without it, every recipe shows. -->
    <div class="toolbar">
      <div class="chips" role="group" aria-label="Filter by category" data-filters hidden>
        <button class="chip" type="button" data-filter="" aria-pressed="true">
          All<span class="count">{recipes.length}</span>
        </button>
        {
          categories.map(([name, n]) => (
            <button class="chip" type="button" data-filter={name} aria-pressed="false">
              {name}
              <span class="count">{n}</span>
            </button>
          ))
        }
      </div>
      <div class="recipe-search" data-search-box hidden>
        <label class="visually-hidden" for="recipe-search">Search recipes</label>
        <Icon name="search" />
        <input
          class="input"
          id="recipe-search"
          type="search"
          placeholder="Search recipes or ingredients…"
          autocomplete="off"
          enterkeyhint="search"
        />
      </div>
    </div>

    <p class="results-status" role="status" data-status></p>

    <div class="no-results" data-empty hidden>
      <p data-empty-message></p>
      <button class="btn btn--ghost" type="button" data-reset>Show all recipes</button>
    </div>

    <ul class="card-grid" data-recipes style="padding-bottom: clamp(48px, 8vw, 88px)">
      {recipes.map((recipe, i) => <RecipeCard recipe={recipe} eager={i < 3} searchText={searchText(recipe)} />)}
    </ul>
  </div>

  <Fragment slot="scripts">
    <script>
      import { queryWords } from '../../lib/search';

      // Category chips and the search box narrow the same list of cards.
      // The category lives in the URL hash (#dinner) and the search in ?q=,
      // so a filtered list survives a refresh and can be shared.
      const cards = [...document.querySelectorAll<HTMLElement>('[data-recipes] > li')];
      const chips = document.querySelector<HTMLElement>('[data-filters]')!;
      const buttons = [...chips.querySelectorAll<HTMLButtonElement>('[data-filter]')];
      const searchBox = document.querySelector<HTMLElement>('[data-search-box]')!;
      const input = document.querySelector<HTMLInputElement>('#recipe-search')!;
      const status = document.querySelector<HTMLElement>('[data-status]')!;
      const empty = document.querySelector<HTMLElement>('[data-empty]')!;
      const emptyMessage = document.querySelector<HTMLElement>('[data-empty-message]')!;

      let category = '';

      function apply() {
        const words = queryWords(input.value);
        let shown = 0;
        for (const card of cards) {
          const text = card.dataset.search ?? '';
          const visible =
            (!category || card.dataset.category === category) && words.every((word) => text.includes(word));
          card.hidden = !visible;
          if (visible) shown++;
        }

        buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filter === category)));

        const filtered = Boolean(category || words.length);
        status.textContent = filtered && shown > 0 ? `Showing ${shown} of ${cards.length} recipes` : '';
        empty.hidden = shown > 0;
        const query = input.value.trim();
        emptyMessage.textContent = `No ${category ? category.toLowerCase() + ' ' : ''}recipes match “${query}”.`;

        const url = new URL(location.href);
        if (query) url.searchParams.set('q', query);
        else url.searchParams.delete('q');
        url.hash = category ? encodeURIComponent(category.toLowerCase()) : '';
        history.replaceState(null, '', url);
      }

      buttons.forEach((b) =>
        b.addEventListener('click', () => {
          category = b.dataset.filter ?? '';
          apply();
        }),
      );
      input.addEventListener('input', apply);
      document.querySelector('[data-reset]')!.addEventListener('click', () => {
        category = '';
        input.value = '';
        apply();
        input.focus();
      });

      // Restore filters from the URL.
      const fromHash = decodeURIComponent(location.hash.slice(1));
      category = buttons.find((b) => b.dataset.filter && b.dataset.filter.toLowerCase() === fromHash)?.dataset.filter ?? '';
      input.value = new URLSearchParams(location.search).get('q') ?? '';
      chips.hidden = false;
      searchBox.hidden = false;
      apply();
    </script>
  </Fragment>
</Base>
