---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import RecipeCard from '../components/RecipeCard.astro';
import Icon from '../components/Icon.astro';
import { getListedRecipes } from '../lib/recipes';
import heroImg from '../../img/recipe/lemon_ricotta_pancakes/lemon_ricotta_pancake_preparation.jpg';
import famPic from '../../img/fam_pic.jpg';

const recipes = await getListedRecipes();
const latest = recipes.slice(0, 3);

// Tells Google the site's name, and that "griddlemethisdad" (the domain,
// typed as one word) and the other spellings refer to this site.
const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Griddle Me This, Dad?',
  alternateName: ['griddlemethisdad', 'Griddle Me This Dad', 'GMTD'],
  url: new URL('/', Astro.site).href,
};
const description = `Griddle Me This, Dad? (griddlemethisdad.com): ${recipes.length} backyard griddle recipes for breakfast, dinner, sides and snacks, plus a monthly newsletter.`;
const [newsletter] = (await getCollection('newsletters')).sort(
  (a, b) => b.data.published.valueOf() - a.data.published.valueOf(),
);
---

<Base title="Home" description={description}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(website)} />
  <section class="hero">
    <Image
      src={heroImg}
      alt="Pancakes cooking on the griddle"
      widths={[640, 1024, 1600, 2000]}
      width={2000}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
    <div class="container">
      <h1>Griddle Me This, Dad?</h1>
      <a class="btn" href="/recipes/">Browse recipes <Icon name="arrow" /></a>
    </div>
  </section>

  <section class="section container">
    <div class="section-head">
      <h2>Latest recipes</h2>
      <a class="link-arrow" href="/recipes/">All recipes <Icon name="arrow" /></a>
    </div>
    <ul class="card-grid">
      {latest.map((recipe) => <RecipeCard recipe={recipe} />)}
    </ul>
  </section>

  <section class="container" style="padding-bottom: clamp(48px, 8vw, 88px)">
    <div class="split">
      <div class="panel feature">
        <Image src={famPic} alt="The family" width={280} />
        <div>
          <p class="eyebrow">About</p>
          <h3>How it started</h3>
          <p>
            A Blackstone griddle birthday present, a lot of time at home in 2020, and a family that kept asking for
            seconds.
          </p>
          <a class="link-arrow" href="/about/">Read the story <Icon name="arrow" /></a>
        </div>
      </div>
      {
        newsletter && (
          <div class="panel feature">
            <Image src={newsletter.data.cover} alt="" width={280} />
            <div>
              <p class="eyebrow">Latest newsletter</p>
              <h3>{newsletter.data.title}</h3>
              <p>Monthly notes on recipes, reviews, music and more.</p>
              <a class="link-arrow" href="/newsletters/">
                All newsletters <Icon name="arrow" />
              </a>
            </div>
          </div>
        )
      }
    </div>
  </section>
</Base>
